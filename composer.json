{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "foutraz/google-calendar": "*",
        "foutraz/outlook": "*",
        "foutraz/strava": "*",
        "foutraz/weather": "*",
        "functional/exploration": "*",
        "functional/moto": "*",
        "functional/finance": "*",
        "functional/goals": "*",
        "functional/planning": "*",
        "functional/recurring-expenses": "*",
        "functional/sport": "*",
        "functional/todo": "*",
        "functional/users": "*",
        "laravel/framework": "^12.0",
        "laravel/socialite": "^5.0",
        "laravel/tinker": "^2.10.1",
        "livewire/livewire": "^3.0",
        "lomkit/laravel-access-control": "^0.3.2",
        "lomkit/laravel-rest-api": "^2.18",
        "predis/predis": "^3.4",
        "spatie/laravel-permission": "^7.2",
        "technical/application": "*",
        "technical/authentication": "*",
        "technical/integrations": "*",
        "technical/osdd": "*",
        "technical/web-authentication": "*",
        "tymon/jwt-auth": "^2.3",
        "xefi/laravel-osdd": "^1.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.52",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3",
        "xefi/faker-php": "^1.5",
        "xefi/faker-php-laravel": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "stan": [
            "@php vendor/bin/phpstan analyse --memory-limit=512M"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../SDK_Strava",
            "options": {
                "symlink": false,
                "versions": {
                    "foutraz/strava": "1.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../SDK_Weather",
            "options": {
                "symlink": false,
                "versions": {
                    "foutraz/weather": "1.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../SDK_GoogleCalendar",
            "options": {
                "symlink": false,
                "versions": {
                    "foutraz/google-calendar": "1.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../SDK_Outlook",
            "options": {
                "symlink": false,
                "versions": {
                    "foutraz/outlook": "1.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "./functional/*"
        },
        {
            "type": "path",
            "url": "./technical/*"
        }
    ]
}
